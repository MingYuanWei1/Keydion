# Keydion environment configuration.
# Copy to `.env` (local development) or `.env.prod` (production) and fill in.
# Lines in the "Required" block must be set; the "Optional" block shows the
# values the app falls back to when the variable is unset.

# ============================================================================
# Required
# ============================================================================

# Flask secret key — use a strong random value in production (NOT dev-secret-key).
# SEC-09: the app refuses to boot if this is empty or "dev-secret-key" unless
# PAPERQUERY_ALLOW_DEV_SECRET=1 is set (start_local.sh sets it for local dev).
PAPERQUERY_SECRET=
# Set to 1 ONLY for local development to permit the insecure default secret.
PAPERQUERY_ALLOW_DEV_SECRET=

# SQLAlchemy connection string (MySQL).
PAPERQUERY_DATABASE_URL="mysql+pymysql://user:password@host:3306/dbname?charset=utf8mb4"

# Microsoft OAuth — must match the Azure app registration redirect URI.
PAPERQUERY_MS_CLIENT_ID=
PAPERQUERY_MS_CLIENT_SECRET=
PAPERQUERY_MS_REDIRECT_URI=

# ============================================================================
# Optional (defaults shown; override only when needed)
# ============================================================================

# --- Microsoft OAuth -------------------------------------------------------
PAPERQUERY_MS_AUTHORITY=https://login.microsoftonline.com/common

# --- AI via Cloudflare Worker ---------------------------------------------
# See docs/deployment/llm-worker.md for deployment and index cutover.
# HTTPS origin only (no /v1). HTTP localhost is allowed for local Wrangler.
LLM_WORKER_URL=https://api.keydion.com
LLM_WORKER_TOKEN=
# Pin the identity reported by /v1/capabilities after verifying it matches the
# existing index. Empty/mismatched identity disables embeddings, not chat/vision.
# Changing endpoint/model/dimensions requires coordinated full re-indexing.
LLM_WORKER_EMBED_ID=

# Maximum inputs per Worker embedding request.
LLM_EMBED_BATCH=10

# Vector column width; changing it requires an Alembic migration and full reindex.
# RAG_EMBED_DIM=3072

# --- Web search for "Keydion AI" web-access toggle -------------------------
# WEB_SEARCH_API_KEY empty = the web-access toggle is hidden.
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=

# --- Application tuning -----------------------------------------------------
PAPERQUERY_MAX_UPLOAD_MB=50
PAPERQUERY_SESSION_TIMEOUT=3600
# Send the session cookie with the Secure flag (HTTPS-only). Default 1 (prod);
# set 0 for local plain-HTTP dev (start_local.sh serves HTTP on :4000).
PAPERQUERY_COOKIE_SECURE=1
PAPERQUERY_OPEN_ACCESS=0
PAPERQUERY_PBKDF_ITERATIONS=260000
PAPERQUERY_RESOURCE_MAX_MB=50

# --- Paper publishing worker -----------------------------------------------
# Poll interval, durable-job lease, inline indexing budget, and abandoned
# publication-reservation grace period. The web and worker units share these.
# Keep the lease at or below 1800 unless the worker unit's 1900-second stop
# timeout and the deployment contract are increased in the same release.
PAPERQUERY_PUBLISHING_WORKER_POLL_SECONDS=5
PAPERQUERY_PUBLISHING_JOB_LEASE_SECONDS=1800
PAPERQUERY_PUBLISHING_INLINE_INDEX_TIMEOUT_SECONDS=45
PAPERQUERY_PUBLISHING_RESERVATION_GRACE_SECONDS=3600

# --- Path overrides (default to repo-relative directories) ------------------
PAPERQUERY_DATA_DIR=
PAPERQUERY_UPLOAD_DIR=
PAPERQUERY_RESOURCES_DIR=

# --- Local dev server bind (used by start_local.sh) ------------------------
HOST=
PORT=

# --- gunicorn (production) -------------------------------------------------
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=sync
GUNICORN_THREADS=1
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
